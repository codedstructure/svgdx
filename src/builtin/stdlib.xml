<svg name="d">
  <!--
  svgdx standard library shapes.

  Note these shapes use inherited styles for stroke and fill, allowing them to
  be overridden by the `<reuse>` element instantiating them.

  They each have a default size, and in many cases an aspect ratio that allows
  specifying either width or height to scale the shape appropriately.
  -->

  <specs>
    <g id="document" stroke="$_theme_stroke" fill="$_theme_fill" stroke-width="$_theme_stroke_width">
      <varTryDefault width="{{ $size * 0.7 }}" height="{{ $size }}"/>
      <varTryDefault width="{{ $height * 0.7 }}" height="{{ $width * 10/7 }}"/>
      <varDefault width="7" height="10"/>
      <var fold="{{min($width, $height) / 4}}"/>
      <path d="M {{$width - $fold}} 0 v $fold h $fold v {{$height - $fold}} h {{-$width}} v {{-$height}} h {{$width - $fold}} l $fold $fold h {{-$fold}} z"
        style="stroke-linejoin:round;stroke:inherit;fill:inherit;stroke-width:inherit"/>
    </g>

    <g id="store" stroke="$_theme_stroke" fill="$_theme_fill" stroke-width="$_theme_stroke_width">
      <varTryDefault width="{{ $size }}" height="{{ $size }}"/>
      <varTryDefault width="{{ $height }}" height="{{ $width }}"/>
      <varDefault width="10" height="10"/>
      <var cap="{{min($height / 5, $width / 4)}}"/>
      <path d="M 0 $cap a {{$width / 2}} $cap 0 0 0 $width 0 a {{$width / 2}} $cap 0 0 0 {{-$width}} 0
        v {{$height - 2 * $cap}} a {{$width / 2}} $cap 0 0 0 $width 0 v {{-($height - 2 * $cap)}}"
        style="stroke:inherit;fill:inherit;stroke-width:inherit"/>
    </g>

    <g id="pipeline" stroke="$_theme_stroke" fill="$_theme_fill" stroke-width="$_theme_stroke_width">
      <varTryDefault width="{{ $size }}" height="{{ $size * 7/15 }}"/>
      <varTryDefault width="{{ $height }}" height="{{ $width }}"/>
      <varDefault width="15" height="7"/>
      <var cap="{{min($width / 5, $height / 4)}}"/>
      <path d="M $cap 0
        a $cap {{$height / 2}} 0 0 0 0 {{-$height}}
        a $cap {{$height / 2}} 0 0 0 0 {{$height}}
        h {{$width - 2 * $cap}}
        a $cap {{$height / 2}} 0 0 0 0 {{-$height}}
        h {{-($width - 2 * $cap)}}"
        style="stroke:inherit;fill:inherit;stroke-width:inherit"/>
    </g>

    <g id="cloud" stroke="$_theme_stroke" fill="$_theme_fill" stroke-width="$_theme_stroke_width">
      <varTryDefault width="{{ $size }}" height="{{ $size * 15/20 }}"/>
      <varTryDefault width="{{ $height * 0.5 }}" height="{{ $width * 2 }}"/>
      <varDefault width="20" height="15"/>
      <path d="M {{$width * 0.2}} {{$height * 0.78}}
        C {{$width * 0.05}} {{$height * 0.78}} 0 {{$height * 0.62}} {{$width * 0.08}} {{$height * 0.5}}
        C {{$width * 0.05}} {{$height * 0.28}} {{$width * 0.22}} {{$height * 0.12}} {{$width * 0.38}} {{$height * 0.18}}
        C {{$width * 0.45}} {{$height * 0.02}} {{$width * 0.7}} 0 {{$width * 0.78}} {{$height * 0.18}}
        C {{$width * 0.94}} {{$height * 0.18}} $width {{$height * 0.34}} {{$width * 0.94}} {{$height * 0.48}}
        C $width {{$height * 0.56}} {{$width * 0.95}} {{$height * 0.78}} {{$width * 0.78}} {{$height * 0.78}}
        C {{$width * 0.7}} $height {{$width * 0.3}} $height {{$width * 0.2}} {{$height * 0.78}} Z"
        style="stroke:inherit;fill:inherit;stroke-width:inherit"/>
    </g>

    <g id="actor" stroke="$_theme_stroke" fill="$_theme_fill" stroke-width="$_theme_stroke_width">
      <varTryDefault width="{{ $size * 0.5 }}" height="{{ $size }}"/>
      <varTryDefault width="{{ $height * 0.5 }}" height="{{ $width * 2 }}"/>
      <varDefault width="5" height="10"/>
      <var head="{{min(0.4 * $height, 0.9 * $width)}}"/>
      <var body="{{$height - $head}}"/>
      <var bhalf="{{$body * 0.5}}" bqtr="{{$body * 0.25}}" whalf="{{$width / 2}}"/>
      <path d="M$whalf $head a 0.1 0.1 0 0 0 0 -$head 0.1 0.1 0 0 0 0 $head // head circle
          v $bhalf m -$whalf -$bqtr h$width m-$whalf $bqtr // body and arms
          l -$whalf $bhalf m$whalf-$bhalf l$whalf $bhalf // legs"
          style="stroke:inherit;fill:inherit;stroke-width:inherit"/>
    </g>

    <g id="message" stroke="$_theme_stroke" fill="$_theme_fill" stroke-width="$_theme_stroke_width">
      <varTryDefault width="{{ $size }}" height="{{ $size * 3/4 }}"/>
      <varTryDefault width="{{ $height * 4/3 }}" height="{{ $width * 3/4 }}"/>
      <varDefault width="8" height="6"/>
      <var wby2="{{ $width / 2 }}" hby2="{{ $height / 2 }}"/>
      <path d="M0 0 l$wby2 $hby2 $wby2 -$hby2 h-$width v$height h$width v-$height"
        style="stroke-linejoin:round;stroke:inherit;fill:inherit;stroke-width:inherit"/>
    </g>

    <g id="gear" stroke="$_theme_stroke" fill="$_theme_fill" stroke-width="$_theme_stroke_width">
      <varDefault size="5" teeth="6"/>
      <var outer="{{$size / 2}}" root="{{$size * 0.35}}" hole="{{$size * 0.15}}" pitch="{{360 / $teeth}}"/>
      <!-- angles in degrees clockwise from 12 o'clock; each tooth is a root arc, a flank
           up to the tip, a tip arc and a flank back down to the root circle -->
      <path d="M $outer {{$outer - $root}} :a 0
          r $teeth[
            A $root $root 0 0 1 {{$outer + $root * sin($a + 0.3 * $pitch)}} {{$outer - $root * cos($a + 0.3 * $pitch)}}
            L {{$outer + $outer * sin($a + 0.5 * $pitch)}} {{$outer - $outer * cos($a + 0.5 * $pitch)}}
            A $outer $outer 0 0 1 {{$outer + $outer * sin($a + 0.8 * $pitch)}} {{$outer - $outer * cos($a + 0.8 * $pitch)}}
            L {{$outer + $root * sin($a + $pitch)}} {{$outer - $root * cos($a + $pitch)}}
            :a {{$a + $pitch}}
          ] z
          M {{$outer - $hole}} $outer a $hole $hole 0 1 0 {{2 * $hole}} 0 a $hole $hole 0 1 0 {{-2 * $hole}} 0"
        fill-rule="evenodd" style="stroke-linejoin:round;stroke:inherit;fill:inherit;stroke-width:inherit"/>
    </g>

    <g id="key" stroke="$_theme_stroke" fill="$_theme_fill" stroke-width="$_theme_stroke_width">
      <varTryDefault width="{{ $size }}" height="{{ $size * 5/12 }}"/>
      <varTryDefault width="{{ $height * 12/5 }}" height="{{ $width * 5/12 }}"/>
      <varDefault width="12" height="5"/>
      <var r="{{$height / 2}}" thick="{{$height * 0.25}}" tooth="{{$height * 0.18}}" hole="{{$height * 0.2}}"/>
      <var top="{{$r - $thick / 2}}" bottom="{{$r + $thick / 2}}"/>
      <var edge="{{$r + sqrt($r * $r - $thick * $thick / 4)}}"/>
      <!-- shaft with two teeth, then a large arc round the bow back to the start; the hole is a cutout -->
      <path d="M $edge $top H $width V {{$bottom + 0.26 * $height}} H {{$width - $tooth}} V $bottom
          H {{$width - 2 * $tooth}} V {{$bottom + 0.18 * $height}} H {{$width - 3 * $tooth}} V $bottom
          H $edge A $r $r 0 1 1 $edge $top z
          M {{$r - $hole}} $r a $hole $hole 0 1 0 {{2 * $hole}} 0 a $hole $hole 0 1 0 {{-2 * $hole}} 0"
        fill-rule="evenodd" style="stroke-linejoin:round;stroke:inherit;fill:inherit;stroke-width:inherit"/>
    </g>

    <g id="cert" stroke="$_theme_stroke" fill="$_theme_fill" stroke-width="$_theme_stroke_width">
      <varTryDefault width="{{ $size * 3/4 }}" height="{{ $size }}"/>
      <varTryDefault width="{{ $height * 3/4 }}" height="{{ $width * 4/3 }}"/>
      <varDefault width="9" height="12"/>
      <var sx="{{$width * 0.7}}" sy="{{$height * 0.7}}" sr="{{$width * 0.12}}"/>
      <path d="M0 0 h$width v$height h-$width z
          M {{$width * 0.3}} {{$height * 0.12}} h {{$width * 0.4}} // title
          M {{$width * 0.15}} {{$height * 0.26}} h {{$width * 0.7}} // body text
          m {{-$width * 0.7}} {{$height * 0.1}} h {{$width * 0.7}}
          m {{-$width * 0.7}} {{$height * 0.1}} h {{$width * 0.7}}
          M {{$width * 0.12}} {{$height * 0.8}} h {{$width * 0.3}} // signature"
          style="stroke:inherit;fill:inherit;stroke-width:inherit"/>
      <!-- ribbon tails first, so the seal is drawn over them -->
      <path d="M {{$sx - 0.7 * $sr}} {{$sy + 0.7 * $sr}} v {{1.3 * $sr}}
          r2[l {{0.35 * $sr}} {{-0.3 * $sr}} l {{0.35 * $sr}} {{0.3 * $sr}}] v {{-1.3 * $sr}}"
          style="stroke:inherit;fill:inherit;stroke-width:inherit"/>
      <circle cxy="$sx $sy" r="$sr"
        style="stroke:inherit;fill:inherit;stroke-width:inherit"/>
    </g>

    <g id="server" stroke="$_theme_stroke" fill="$_theme_fill" stroke-width="$_theme_stroke_width">
      <varTryDefault width="{{ $size * 0.8 }}" height="{{ $size }}"/>
      <varTryDefault width="{{ $height * 0.8 }}" height="{{ $width * 5/4 }}"/>
      <varDefault width="6" height="7.5"/>
      <var unit="{{$height / 3}}" led="{{$height * 0.03}}"/>
      <!-- three stacked units, each with a drive slot and a status LED -->
      <path d="M0 0 h$width v$height h-$width z
          M 0 $unit r2[h $width m {{-$width}} $unit]
          :y {{$unit / 2}}
          r3[
            M {{$width * 0.15}} $y h {{$width * 0.5}}
            M {{$width * 0.8 - $led}} $y a $led $led 0 1 0 {{2 * $led}} 0 a $led $led 0 1 0 {{-2 * $led}} 0
            :y {{$y + $unit}}
          ]"
          style="stroke:inherit;fill:inherit;stroke-width:inherit"/>
    </g>

    <g id="switch" stroke="$_theme_stroke" fill="$_theme_fill" stroke-width="$_theme_stroke_width">
      <varTryDefault width="{{ $size }}" height="{{ $size * 3/4 }}"/>
      <varTryDefault width="{{ $height * 4/3 }}" height="{{ $width * 3/4 }}"/>
      <varDefault width="8" height="6"/>
      <var head="{{$height * 0.12}}" arrow="{{$width * 0.6}}"/>
      <!-- a pair of opposed arrows; arrowheads are separate subpaths so their tips join cleanly -->
      <path d="M0 0 h$width v$height h-$width z
          M {{$width * 0.2}} {{$height * 0.35}} h $arrow m {{-$head}} {{-$head}} l $head $head l {{-$head}} $head
          M {{$width * 0.8}} {{$height * 0.65}} h {{-$arrow}} m $head {{-$head}} l {{-$head}} $head l $head $head"
        style="stroke-linejoin:round;stroke-linecap:round;stroke:inherit;fill:inherit;stroke-width:inherit"/>
    </g>

    <g id="firewall" stroke="$_theme_stroke" fill="$_theme_fill" stroke-width="$_theme_stroke_width">
      <varTryDefault width="{{ $size }}" height="{{ $size * 4/5 }}"/>
      <varTryDefault width="{{ $height * 5/4 }}" height="{{ $width * 4/5 }}"/>
      <varDefault width="10" height="8"/>
      <var row="{{$height / 4}}" half="{{$width / 2}}" qtr="{{$width / 4}}"/>
      <!-- brick wall: four courses, alternate courses offset by half a brick -->
      <path d="M0 0 h$width v$height h-$width z
          M 0 $row r3[h $width m {{-$width}} $row]
          M $half 0 r2[v $row m -$qtr 0 v $row m $half 0 v {{-$row}} m -$qtr $row]"
          style="stroke:inherit;fill:inherit;stroke-width:inherit"/>
    </g>

    <g id="router" stroke="$_theme_stroke" fill="$_theme_fill" stroke-width="$_theme_stroke_width">
      <varTryDefault width="{{ $size }}" height="{{ $size }}"/>
      <varTryDefault width="{{ $height }}" height="{{ $width }}"/>
      <varDefault width="8" height="8"/>
      <var r="{{min($width, $height) / 2}}" cx="{{$width / 2}}" cy="{{$height / 2}}"/>
      <var arm="{{$r * 0.7}}" head="{{$r * 0.2}}"/>
      <!-- circle with four arrows, one per axis direction; each arm is drawn along the current bearing -->
      <path d="M {{$cx - $r}} $cy a $r $r 0 1 0 {{2 * $r}} 0 a $r $r 0 1 0 {{-2 * $r}} 0
          M $cx $cy
          r4[b 90 h $arm m {{-$head}} {{-$head}} l $head $head l {{-$head}} $head M $cx $cy]"
        style="stroke-linejoin:round;stroke-linecap:round;stroke:inherit;fill:inherit;stroke-width:inherit"/>
    </g>
  </specs>
</svg>
